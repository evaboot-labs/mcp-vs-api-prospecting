      ],
      "webhookId": "76991115-a186-4e66-8075-13ee7ce79744"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.evaboot.com/v1/extractions/{{ $('API: start export').first().json.extraction_id }}/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "9cb98d7f-a38c-4366-9046-61fd8c8d5fab",
      "name": "API: poll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        260
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot (Bearer API key)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "s",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e9feeb14-025f-4813-b23a-7d9d44d2189d",
      "name": "API: finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1140,
        260
      ]
    },
    {
