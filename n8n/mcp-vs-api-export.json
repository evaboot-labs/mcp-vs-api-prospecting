        "genericAuthType": "httpBearerAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ linkedin_url: $('Your settings').first().json.list_url, search_name: 'MCP vs API test (n8n, API)' }) }}"
      },
      "id": "9c3c4ffc-5c16-4b97-bc77-025b2b9805fe",
      "name": "API: start export",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
