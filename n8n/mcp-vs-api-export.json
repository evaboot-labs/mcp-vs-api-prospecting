        }
      },
      "id": "525f64dd-e17c-40eb-87ce-406dd3fcbbfc",
      "name": "API: done at",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1360,
        240
      ]
    },
    {
      "parameters": {
        "mode": "chooseBranch",
        "chooseBranchMode": "waitForAll",
        "output": "empty"
      },
      "id": "9cdb228f-f6b6-4791-a2ad-3a9e3c5bfe4e",
      "name": "Wait for both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        1580,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// One row per branch: what came back and how long it took.\nconst s = $('Your settings').first().json;\nconst started = new Date(s.started_at);\nconst row = (path, leads, endedAt) => ({\n  path,\n  leads: leads.length,\n  emails_found: leads.filter(l => l['Email']).length,\n  safe_emails: leads.filter(l => l['Email Status'] === 'safe').length,\n  seconds: Math.round((new Date(endedAt) - started) / 1000),\n});\nconst r = $('MCP: results').last().json;\nconst mcpLeads = r.structuredContent?.result?.prospects || r.result?.prospects || [];\nconst apiLeads = $('API: poll').last().json.body.prospects || [];\nreturn [row('MCP', mcpLeads, $('MCP: done at').first().json.done_at),\n        row('API', apiLeads, $('API: done at').first().json.done_at)].map(json => ({ json }));\n"
      },
      "id": "0d36fdc1-72ba-43c4-95a9-c958082ed92e",
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        120
      ]
    }
  ],
