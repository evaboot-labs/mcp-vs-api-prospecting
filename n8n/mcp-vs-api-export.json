      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "Evaboot (Bearer API key)"
        }
      }
    },
    {
      "parameters": {
        "amount": 30
      },
      "id": "36ffbf7f-fc19-442a-871e-d19d501e4292",
      "name": "API: wait 30 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
